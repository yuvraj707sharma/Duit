# FastAgent Environment Configuration

# App & Server Settings
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=change_this_to_a_random_32_character_secret_key!
TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_aes_key==  # Generate with: openssl rand -base64 32
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,capacitor://localhost

# Database Configuration (MySQL, PostgreSQL, or SQLite)
# MySQL 8+ (aiomysql):
# DATABASE_URL=mysql+aiomysql://root:your_mysql_password@localhost:3306/fastagent
# SQLite (offline default):
# DATABASE_URL=sqlite+aiosqlite:///fastagent.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://fastagent:fastagent_dev_password@localhost:5432/fastagent
DATABASE_URL=sqlite+aiosqlite:///fastagent.db

# Redis (for Arq async worker and rate limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=fastagent_redis_dev_password
REDIS_URL=redis://:fastagent_redis_dev_password@localhost:6379/0

# Decision Layer (Laya)
LAYA_BASE_URL=http://localhost:8001
LAYA_ROUTER_DEFAULT=multilingual
LAYA_MIN_CONFIDENCE_THRESHOLD=0.75
USE_MOCK_DECISION=false

# LLM Providers
DEFAULT_LLM_PROVIDER=gemini  # options: gemini, ollama, mock
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
USE_MOCK_LLM=false

# Messaging Channels
MESSAGING_CHANNEL=evolution  # options: evolution, mock
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_GLOBAL_API_KEY=replace_with_evolution_global_api_key
EVOLUTION_INSTANCE_NAME=duit-primary
EVOLUTION_WEBHOOK_SECRET=replace_with_evolution_webhook_secret
WHATSAPP_AUTHORIZED_NUMBERS=  # Comma-separated list of authorized numbers, e.g. 919876543210

# Desktop & Gateway Shared Secrets
DESKTOP_SHARED_SECRET=replace_with_random_desktop_secret
GATEWAY_SHARED_SECRET=replace_with_random_gateway_secret

# Google OAuth (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
USE_MOCK_TOOLS=false
