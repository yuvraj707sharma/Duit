{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastagent.dev/schemas/intent.json",
  "title": "Intent",
  "description": "Allowed user intent classifications for FastAgent v1 (must remain <20 items).",
  "type": "string",
  "enum": [
    "schedule_meeting",
    "reschedule_meeting",
    "cancel_meeting",
    "check_calendar",
    "reply_email",
    "summarize_email",
    "send_email",
    "book_something",
    "open_app",
    "open_url",
    "create_note",
    "type_text",
    "set_volume",
    "search_files",
    "clear_history",
    "other"
  ]
}
