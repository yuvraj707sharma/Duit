{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAgent API",
    "description": "Fast, cheap, safe AI scheduling & email assistant cascade backend",
    "version": "1.0.0"
  },
  "paths": {
    "/api/webhooks/evolution": {
      "post": {
        "summary": "Receive Evolution Go WhatsApp Webhook",
        "description": "Receives real-time incoming WhatsApp messages, validates signature/token, and invokes cascade.",
        "responses": {
          "200": { "description": "Webhook received and processed" },
          "401": { "description": "Unauthorized webhook token" }
        }
      }
    },
    "/api/webhooks/whatsapp": {
      "post": {
        "summary": "Receive FastAgent WhatsApp Gateway Message",
        "description": "Receives incoming message forwarded by WhatsApp bot gateway (Baileys), processes through cascade, and returns assistant reply.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["from", "text"],
                "properties": {
                  "from": { "type": "string" },
                  "text": { "type": "string" },
                  "channel": { "type": "string", "default": "whatsapp" },
                  "idempotency_key": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Processed message response" },
          "400": { "description": "Invalid payload format" },
          "401": { "description": "Unauthorized: missing or invalid gateway secret" }
        },
        "security": [{ "gatewaySecret": [] }]
      }
    },
    "/api/approvals": {
      "get": {
        "summary": "List Pending Approvals",
        "description": "Lists pending approvals. User can only view their own approvals; administrators may view broader data.",
        "parameters": [
          { "name": "user_id", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of pending approval requests" },
          "401": { "description": "Unauthorized: user authentication required" },
          "403": { "description": "Forbidden: cannot access another user's approvals" }
        },
        "security": [{ "userAuth": [] }]
      }
    },
    "/api/approvals/{approval_id}/resolve": {
      "post": {
        "summary": "Approve, Edit, or Reject Action",
        "description": "Resolves a pending approval. User can only resolve their own approvals.",
        "parameters": [
          { "name": "approval_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["decision"],
                "properties": {
                  "decision": { "type": "string", "enum": ["approve", "edit", "reject"] },
                  "edited_payload": { "type": "object" },
                  "user_feedback": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Approval decision applied and logged to learning dataset" },
          "401": { "description": "Unauthorized: user authentication required" },
          "403": { "description": "Forbidden: cannot resolve another user's approval" },
          "404": { "description": "Approval request not found" },
          "410": { "description": "Approval request expired" }
        },
        "security": [{ "userAuth": [] }]
      }
    },
    "/api/approvals/{approval_id}/amend": {
      "post": {
        "summary": "Amend Pending Approval Parameters",
        "description": "Updates pending action arguments in place without creating dangling or duplicate approval requests.",
        "parameters": [
          { "name": "approval_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amendments"],
                "properties": {
                  "amendments": { "type": "object" },
                  "caller_user_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pending approval parameters amended successfully" },
          "400": { "description": "Cannot amend expired or already resolved approval" },
          "404": { "description": "Approval not found" }
        }
      }
    },
    "/api/approvals/cleanup": {
      "post": {
        "summary": "Cleanup Expired Approvals",
        "description": "Transitions expired pending approvals to expired state and writes audit logs.",
        "responses": {
          "200": { "description": "Count of expired approvals cleaned up" }
        }
      }
    },
    "/api/audit-logs": {
      "get": {
        "summary": "Retrieve Audit and Action Logs",
        "description": "Lists audit logs. User can only view their own audit logs.",
        "parameters": [
          { "name": "user_id", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Action log history" },
          "401": { "description": "Unauthorized: user authentication required" },
          "403": { "description": "Forbidden: cannot access another user's audit logs" }
        },
        "security": [{ "userAuth": [] }]
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "System Metrics & Stage Latencies",
        "responses": {
          "200": { "description": "Per-stage latency breakdown (rules, laya, llm, policy, tool) and cost counters" }
        }
      }
    },
    "/api/auth/google/url": {
      "get": {
        "summary": "Get Google OAuth Login URL",
        "responses": { "200": { "description": "OAuth URL" } }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "summary": "Google OAuth Callback",
        "description": "Exchanges Google OAuth code for tokens with cryptographically verified CSRF state protection.",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OAuth success and tokens encrypted" },
          "400": { "description": "Invalid, expired, or reused OAuth state" }
        }
      }
    },
    "/api/auth/google/initiate": {
      "post": {
        "summary": "Initiate Server-Verified Google OAuth Flow",
        "description": "Generates a signed, tamper-proof state token bound to tenant and user identity, returning OAuth authorization URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "user_id"],
                "properties": {
                  "tenant_id": { "type": "string" },
                  "user_id": { "type": "string" },
                  "scopes": { "type": "array", "items": { "type": "string" } },
                  "ttl_seconds": { "type": "integer", "default": 600 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Signed state token and Google OAuth URL" },
          "400": { "description": "Invalid tenant or user identity" }
        }
      }
    },
    "/api/auth/google/revoke": {
      "post": {
        "summary": "Revoke Google OAuth Connection",
        "description": "Cryptographically revokes stored Google access and refresh tokens for the authenticated user and tenant.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "user_id"],
                "properties": {
                  "tenant_id": { "type": "string" },
                  "user_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OAuth connection and capability tokens revoked" }
        }
      }
    },
    "/api/auth/tokens/status": {
      "get": {
        "summary": "Get OAuth Connection and Capability Scopes Status",
        "description": "Returns connection status and active capability scopes for user.",
        "parameters": [
          { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "tenant_id", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OAuth connection status and scopes" }
        }
      }
    },
    "/connect": {
      "get": {
        "summary": "Mobile Onboarding Web Portal",
        "description": "User-facing responsive 1-click Google OAuth connection page for WhatsApp users",
        "parameters": [
          { "name": "phone", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "HTML onboarding portal with 1-click Google OAuth" } }
      }
    },
    "/api/desktop/presence": {
      "get": {
        "summary": "Check Desktop Executor Presence",
        "description": "Returns online/offline presence status for a user's desktop sidecar",
        "parameters": [
          { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User desktop presence status (online/offline, last_heartbeat)" }
        }
      },
    "/api/desktop/voice/transcribe": {
      "post": {
        "summary": "Ultra-Low-Latency Local Voice STT Transcription",
        "description": "Transcribes push-to-talk audio chunks via local faster-whisper INT8 engine with Silero VAD",
        "parameters": [
          { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Transcription result with text, latency_ms, and confidence" }
        }
      }
    },
    "/api/desktop/ws": {
      "get": {
        "summary": "Desktop Executor Outbound WebSocket Tunnel",
        "description": "WebSocket connection endpoint for local desktop python sidecar with heartbeats and shared secret auth",
        "parameters": [
          { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "101": { "description": "Switching protocols to WebSocket tunnel" },
          "401": { "description": "Unauthorized shared secret" }
        }
      }
    },
    "/api/whatsapp/status": {
      "get": {
        "summary": "WhatsApp Session Status",
        "description": "Returns current WhatsApp connection state (open, connecting, close) and instance name",
        "responses": {
          "200": { "description": "WhatsApp session status" }
        }
      }
    },
    "/api/whatsapp/qr": {
      "get": {
        "summary": "WhatsApp Pairing QR Code",
        "description": "Returns pairing QR code (data URL or base64) for scanning. Requires administrator authentication.",
        "responses": {
          "200": { "description": "QR code for pairing" },
          "401": { "description": "Unauthorized: admin authentication required" },
          "403": { "description": "Forbidden: admin privileges required" },
          "404": { "description": "Session already connected or QR unavailable" }
        },
        "security": [{ "userAuth": [] }]
      }
    },
    "/api/linking/sessions": {
      "post": {
        "summary": "Create Short-Lived WhatsApp Linking Transaction",
        "description": "Initializes a secure pairing session bound to tenant_id, user_id, nonce, and expiry time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "user_id"],
                "properties": {
                  "tenant_id": { "type": "string" },
                  "user_id": { "type": "string" },
                  "phone_number": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Linking session created with pairing code and nonce" },
          "400": { "description": "Invalid tenant or user parameters" }
        }
      }
    },
    "/api/linking/sessions/{session_id}/status": {
      "get": {
        "summary": "Get WhatsApp Linking Session Status",
        "parameters": [
          { "name": "session_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Current status of linking transaction" },
          "404": { "description": "Linking session not found" }
        }
      }
    },
    "/api/linking/sessions/{session_id}/pair": {
      "post": {
        "summary": "Confirm WhatsApp Account Pairing",
        "parameters": [
          { "name": "session_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nonce", "pairing_code"],
                "properties": {
                  "nonce": { "type": "string" },
                  "pairing_code": { "type": "string" },
                  "phone_number": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Account paired, encrypted credentials saved, activation confirmed" },
          "400": { "description": "Invalid nonce, pairing code mismatch, or session expired" }
        }
      }
    },
    "/api/linking/sessions/{session_id}/revoke": {
      "post": {
        "summary": "Revoke WhatsApp Account and Session Credentials",
        "parameters": [
          { "name": "session_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Account and session credentials revoked" },
          "404": { "description": "Session not found" }
        }
      }
    },
    "/api/desktop/pair/initiate": {
      "post": {
        "summary": "Initiate Desktop Device Pairing",
        "description": "Generates a short-lived pairing code and nonce for workstation desktop agent enrollment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "user_id"],
                "properties": {
                  "tenant_id": { "type": "string" },
                  "user_id": { "type": "string" },
                  "ttl_seconds": { "type": "integer", "default": 600 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Desktop pairing transaction created with code and nonce" }
        }
      }
    },
    "/api/desktop/pair/claim": {
      "post": {
        "summary": "Claim Desktop Device Pairing Code",
        "description": "Workstation claims pairing code, sends device hardware fingerprint and public key, and receives device UUID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pairing_code", "nonce", "device_name", "platform"],
                "properties": {
                  "pairing_code": { "type": "string" },
                  "nonce": { "type": "string" },
                  "device_name": { "type": "string" },
                  "platform": { "type": "string", "enum": ["windows", "macos", "linux"] },
                  "public_key": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Device enrolled successfully" },
          "400": { "description": "Invalid code or expired session" }
        }
      }
    },
    "/api/desktop/kill": {
      "post": {
        "summary": "Emergency Desktop Agent Kill Switch",
        "description": "Immediately disconnects workstation, revokes device credentials, and halts all local operations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["device_id"],
                "properties": {
                  "device_id": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Device killed and credentials revoked" }
        }
      }
    },
    "/api/desktop/journal": {
      "post": {
        "summary": "Append to Encrypted Local Journal",
        "description": "Appends HMAC-signed entry to audit journal verifying local execution integrity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["device_id", "action", "signature"],
                "properties": {
                  "device_id": { "type": "string" },
                  "action": { "type": "string" },
                  "arguments_hash": { "type": "string" },
                  "status": { "type": "string" },
                  "signature": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Journal entry recorded and verified" }
        }
      }
    },
    "/api/archive/search": {
      "post": {
        "summary": "Search Archived WhatsApp Messages",
        "description": "Performs structured, tenant-isolated message search with date ranges, contact matching, and source citations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "whatsapp_account_id"],
                "properties": {
                  "tenant_id": { "type": "string" },
                  "whatsapp_account_id": { "type": "string" },
                  "query": { "type": "string" },
                  "contact": { "type": "string" },
                  "sender_phone": { "type": "string" },
                  "direction": { "type": "string", "enum": ["inbound", "outbound"] },
                  "start_date": { "type": "string", "format": "date-time" },
                  "end_date": { "type": "string", "format": "date-time" },
                  "limit": { "type": "integer", "default": 20 },
                  "offset": { "type": "integer", "default": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Search results with source citations and coverage metadata" },
          "400": { "description": "Invalid search criteria or tenant boundary violation" }
        }
      }
    },
    "/api/archive/summary": {
      "post": {
        "summary": "Generate Structured Summary with Citations",
        "description": "Summarizes archived messages for an account with exact timestamp citations and truthful absence reporting.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "whatsapp_account_id"],
                "properties": {
                  "tenant_id": { "type": "string" },
                  "whatsapp_account_id": { "type": "string" },
                  "query": { "type": "string" },
                  "contact": { "type": "string" },
                  "limit": { "type": "integer", "default": 10 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Structured executive summary with citations" },
          "400": { "description": "Invalid criteria" }
        }
      }
    },
    "/api/outbox/publish": {
      "post": {
        "summary": "Dispatch Pending Outbox Events",
        "description": "Polls, transitions, and dispatches pending transactional outbox events with exponential backoff.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "batch_size": { "type": "integer", "default": 20 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Batch dispatch results including processed, failed, and dead-letter counts" }
        }
      }
    },
    "/api/outbox/acknowledge": {
      "post": {
        "summary": "Acknowledge Outbound Delivery Receipt",
        "description": "Records gateway delivery confirmation (e.g. from WhatsApp/Baileys) matching idempotency key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["idempotency_key"],
                "properties": {
                  "idempotency_key": { "type": "string" },
                  "provider_message_id": { "type": "string" },
                  "delivered_at": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Delivery acknowledged and recorded" },
          "404": { "description": "Outbox event not found" }
        }
      }
    },
    "/api/outbox/status/{idempotency_key}": {
      "get": {
        "summary": "Get Outbox Event Status",
        "description": "Queries the real-time delivery status and lifecycle stage of an outbound event.",
        "parameters": [
          {
            "name": "idempotency_key",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Current outbox event lifecycle status" },
          "404": { "description": "Event not found" }
        }
      }
    },
    "/api/users/onboard": {
      "post": {
        "summary": "Register or Onboard User Phone Number",
        "description": "Registers a phone number and maps it to a unique user UUID with initial policy settings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone_number"],
                "properties": {
                  "phone_number": { "type": "string" },
                  "email": { "type": "string" },
                  "display_name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User successfully registered with tenant UUID" }
        }
      }
    },
    "/api/skills": {
      "get": {
        "summary": "List Available and Installed Skills",
        "description": "Lists global skill templates and user-specific skills. Requires authentication.",
        "parameters": [
          { "name": "user_id", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of active and available skills" },
          "401": { "description": "Unauthorized: authentication required" }
        },
        "security": [{ "userAuth": [] }]
      },
      "post": {
        "summary": "Create or Install a Skill",
        "description": "Registers a new prompt-based or webhook-based skill for a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "system_prompt"],
                "properties": {
                  "user_id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "system_prompt": { "type": "string" },
                  "trigger_keywords": { "type": "string" },
                  "webhook_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Skill successfully registered" },
          "401": { "description": "Unauthorized: admin authentication required" }
        },
        "security": [{ "gatewaySecret": [] }]
      }
    },
    "/api/skills/{skill_id}": {
      "delete": {
        "summary": "Delete or Deactivate a Skill",
        "parameters": [
          { "name": "skill_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Skill deleted" },
          "401": { "description": "Unauthorized: admin authentication required" }
        },
        "security": [{ "gatewaySecret": [] }]
      }
    },
    "/api/privacy/export": {
      "get": {
        "summary": "Export User Personal Data",
        "description": "Exports all data associated with the authenticated user across tenants, messages, devices, and executions.",
        "responses": {
          "200": { "description": "Complete user data export payload" },
          "401": { "description": "Unauthorized: user authentication required" }
        },
        "security": [{ "userAuth": [] }]
      }
    },
    "/api/privacy/purge": {
      "post": {
        "summary": "Purge User Personal Data",
        "description": "Permanently purges or redacts data belonging to the user with explicit confirmation flag.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["confirm"],
                "properties": {
                  "confirm": { "type": "boolean" },
                  "purge_messages": { "type": "boolean", "default": true },
                  "purge_approvals": { "type": "boolean", "default": true },
                  "purge_executions": { "type": "boolean", "default": true },
                  "revoke_tokens": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User data successfully purged" },
          "400": { "description": "Missing confirmation flag" },
          "401": { "description": "Unauthorized: user authentication required" }
        },
        "security": [{ "userAuth": [] }]
      }
    },
    "/api/privacy/retention/cleanup": {
      "post": {
        "summary": "Execute Data Retention Cleanup",
        "description": "Cleans up archived messages and execution logs older than the tenant retention window.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["retention_days"],
                "properties": {
                  "tenant_id": { "type": "string" },
                  "retention_days": { "type": "integer", "minimum": 1 },
                  "purge_messages": { "type": "boolean", "default": true },
                  "purge_executions": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Retention policy executed" },
          "401": { "description": "Unauthorized: admin access required" }
        },
        "security": [{ "gatewaySecret": [] }]
      }
    },
    "/api/auth/revoke-all": {
      "post": {
        "summary": "Global Session and Credential Revocation",
        "description": "Globally revokes all active WhatsApp accounts, desktop devices, and OAuth tokens for the authenticated user.",
        "responses": {
          "200": { "description": "All sessions and credentials revoked" },
          "401": { "description": "Unauthorized: user authentication required" }
        },
        "security": [{ "userAuth": [] }]
      }
    },
    "/api/security/validate-url": {
      "post": {
        "summary": "Validate URL against SSRF and Internal Network Subnets",
        "description": "Verifies that an outbound URL does not target loopback, private, carrier-grade NAT, or cloud metadata networks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string" },
                  "allowed_domains": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "URL safety check result" },
          "400": { "description": "Unsafe or prohibited URL" }
        }
      }
    },
    "/api/metrics/telemetry": {
      "get": {
        "summary": "Retrieve OpenTelemetry-Compatible System Metrics",
        "description": "Exposes latency percentiles, error rates, queue depths, and operational metrics.",
        "responses": {
          "200": { "description": "System telemetry and performance metrics" }
        }
      }
    },
    "/api/metrics/alerts": {
      "get": {
        "summary": "Retrieve Active Operational Alerts",
        "description": "Reports threshold violations including abnormal pairing attempts, delivery backlogs, and auth errors.",
        "responses": {
          "200": { "description": "List of active alert conditions" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "gatewaySecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-gateway-secret",
        "description": "Shared secret for server-to-server authentication between gateway and backend"
      },
      "userAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id",
        "description": "Authenticated user identity header, paired with gateway or session token"
      }
    }
  }
}
}

