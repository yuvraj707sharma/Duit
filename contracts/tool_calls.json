{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastagent.dev/schemas/tool_calls.json",
  "title": "ToolCalls",
  "description": "Schemas for tools invoked by FastAgent with mandatory idempotency keys on side effects.",
  "definitions": {
    "SendEmail": {
      "type": "object",
      "required": ["idempotency_key", "recipient", "subject", "body"],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "description": "Unique client-side/session UUID preventing double execution."
        },
        "recipient": {
          "type": "string",
          "format": "email",
          "description": "Recipient email address."
        },
        "subject": {
          "type": "string",
          "description": "Subject line of the email."
        },
        "body": {
          "type": "string",
          "description": "Body text of the email."
        },
        "thread_id": {
          "type": "string",
          "description": "Optional Gmail thread ID if replying."
        }
      }
    },
    "CreateCalendarEvent": {
      "type": "object",
      "required": ["idempotency_key", "title", "start_time", "end_time"],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "description": "Unique UUID preventing duplicate calendar bookings."
        },
        "title": {
          "type": "string",
          "description": "Title or summary of the meeting."
        },
        "start_time": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 start timestamp."
        },
        "end_time": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 end timestamp."
        },
        "attendees": {
          "type": "array",
          "items": { "type": "string", "format": "email" },
          "description": "List of attendee emails."
        },
        "description": {
          "type": "string",
          "description": "Optional agenda/description."
        }
      }
    },
    "RescheduleCalendarEvent": {
      "type": "object",
      "required": ["idempotency_key", "event_id", "new_start_time", "new_end_time"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "event_id": { "type": "string" },
        "new_start_time": { "type": "string", "format": "date-time" },
        "new_end_time": { "type": "string", "format": "date-time" }
      }
    },
    "CancelCalendarEvent": {
      "type": "object",
      "required": ["idempotency_key", "event_id"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "event_id": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "ListCalendarEvents": {
      "type": "object",
      "required": ["time_min", "time_max"],
      "properties": {
        "time_min": { "type": "string", "format": "date-time" },
        "time_max": { "type": "string", "format": "date-time" },
        "max_results": { "type": "integer", "default": 10 }
      }
    },
    "FetchEmails": {
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "max_results": { "type": "integer", "default": 5 }
      }
    },
    "OpenApp": {
      "type": "object",
      "required": ["idempotency_key", "app_name"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "app_name": {
          "type": "string",
          "description": "Target desktop application name or executable to dynamically discover and launch."
        },
        "draft_text": {
          "type": "string",
          "description": "Optional draft content to initialize application with."
        },
        "profile": {
          "type": "string",
          "description": "Optional browser user profile directory or display name (e.g. 'Person 1', 'Yuvraj', 'jecrcu.edu.in', 'Profile 2', 'Default')."
        }
      }
    },
    "OpenUrl": {
      "type": "object",
      "required": ["idempotency_key", "url"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "browser": {
          "type": "string",
          "description": "Optional target browser (e.g. edge, chrome, default)."
        },
        "profile": {
          "type": "string",
          "description": "Optional browser user profile directory or display name (e.g. 'Person 1', 'Yuvraj', 'jecrcu.edu.in', 'Profile 2', 'Default')."
        }
      }
    },
    "CreateNote": {
      "type": "object",
      "required": ["idempotency_key", "title", "content"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" }
      }
    },
    "TypeText": {
      "type": "object",
      "required": ["idempotency_key", "text"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "SetVolume": {
      "type": "object",
      "required": ["idempotency_key", "level"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "level": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "SearchFiles": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "description": "Search substring or file name to locate and read." },
        "directory": { "type": "string" },
        "read_content": { "type": "boolean", "default": true, "description": "Whether to read and return text content from matched file." }
      }
    },
    "ClearHistory": {
      "type": "object",
      "required": ["idempotency_key"],
      "properties": {
        "idempotency_key": { "type": "string" }
      }
    },
    "ShedStatus": {
      "type": "object",
      "properties": {
        "include_sessions": { "type": "boolean", "default": true }
      }
    },
    "DispatchCodingTask": {
      "type": "object",
      "required": ["idempotency_key", "prompt"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "prompt": { "type": "string" },
        "harness": { "type": "string", "default": "auto" }
      }
    },
    "AutomateCart": {
      "type": "object",
      "required": ["idempotency_key", "product_name"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "product_name": { "type": "string" },
        "store": { "type": "string", "default": "amazon" }
      }
    },
    "ListBrowserProfiles": {
      "type": "object",
      "properties": {
        "browser": {
          "type": "string",
          "description": "Target browser: 'chrome' or 'edge'. Defaults to 'chrome'.",
          "default": "chrome"
        }
      }
    }
  }
}
