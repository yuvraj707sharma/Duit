# ─────────────────────────────────────────────────────────────────────────────
# FastAgent WhatsApp Bot — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5122
APP_PUBLIC_URL=http://localhost:5122

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fastagent_wa

# FastAgent Backend (Python/FastAPI)
# This is the URL of your backend/app where WhatsApp messages are routed for AI
BACKEND_URL=http://localhost:8000

# Google OAuth2 (https://console.cloud.google.com → APIs & Services → Credentials)
# Create an OAuth 2.0 Client ID of type "Web application"
# Add http://localhost:5122/auth/google/callback as an Authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5122/auth/google/callback

# Admin Dashboard Login (default credentials seeded automatically)
# Change ADMIN_PASSWORD in your .env before deploying to production
ADMIN_EMAIL=admin@fastagent.ai
ADMIN_PASSWORD=admin123
